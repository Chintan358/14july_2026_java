package A007_oops;

class User
{
	String name;
	String email;
	int phone;
	
	User()
	{
		System.out.println("hello");
	}
	
	public void display()
	{
		System.out.println(name+" "+email+" "+phone);
	}
	
	
	
}

public class O004_ConstructoreDemo {
	public static void main(String[] args) {
		
		User u = new User();
		u.display();
		
	}
}
