package A006_Array;

public class A003_ArrayOperation {
	public static void main(String[] args) {
		
		int a[] = {10,20,40,50,85,1,2,34,95,22,45};
		
		int sum = 0;
		for (int i = 0; i < a.length; i++) {
			sum+=a[i];
		}
		
		System.out.println(sum);
		System.out.println(sum/a.length);
		
		
		
	}
}
