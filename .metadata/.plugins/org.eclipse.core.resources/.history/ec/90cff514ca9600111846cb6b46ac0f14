package A007_oops;

class Pen
{
	int price;
	String color;
	String company;
	
	void toWrite()
	{
		System.out.println(price+" "+color+" "+company);
	}
}

public class O001_ClassDemo {
	public static void main(String[] args) {
		
		
		Pen p1 = new Pen();
		p1.price=50;
		p1.color="RED";
		p1.company="CEllo";
		p1.toWrite();
		
		
		Pen p2 = new Pen();
		p2.price=20;
		p2.color="BLACK";
		p2.company="SS";
		p2.toWrite();
		
	}
}
